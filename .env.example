# -----------------------------------------------------------------------------
# PinNudge environment configuration
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional: with nothing set, the app runs in local demo
# mode (file-based data, sample content instead of AI, billing disabled).
# -----------------------------------------------------------------------------

# Public base URL of the deployment (used for auth redirects, Stripe return URLs
# and metadata). Choose the domain after availability/trademark checks.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Support contact shown on the Help and Privacy pages (optional).
NEXT_PUBLIC_SUPPORT_EMAIL=

# --- Supabase (database, auth, storage) --------------------------------------
# From Supabase dashboard → Project Settings → API (or `npx supabase status`
# for the local stack). The anon/publishable key is safe in the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server-only. Required in Supabase mode for quota reservation, Stripe
# webhooks and account deletion. NEVER expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Data mode: auto (Supabase if configured, else local demo), supabase, or local.
PINNUDGE_DATA_MODE=auto
# Local demo mode is disabled in production builds unless explicitly allowed
# (it stores data in a file and is not suitable for real customers).
PINNUDGE_ALLOW_LOCAL_MODE_IN_PRODUCTION=false
# Where local demo mode stores its JSON file and uploads (default: ./.data).
PINNUDGE_LOCAL_DATA_DIR=
# Secret for signing local demo session cookies (auto-generated if empty).
PINNUDGE_SESSION_SECRET=

# --- AI copy generation -------------------------------------------------------
# Leave ANTHROPIC_API_KEY empty to use the clearly labelled demo generator.
# Set AI_PROVIDER=demo to force demo mode even when a key is present.
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=
# Explicit model identifier (required for live generation).
AI_MODEL=claude-opus-5-5
# Reasoning effort: low | medium | high | xhigh | max. "low" keeps marketing
# copy fast and inexpensive; raise it if quality needs it.
AI_EFFORT=low
AI_TIMEOUT_MS=90000
AI_MAX_OUTPUT_TOKENS=16000
# Optional per-million-token prices (USD) for internal cost estimates. Defaults
# exist for current Claude models; set these when using another model.
AI_INPUT_COST_PER_MTOK=
AI_OUTPUT_COST_PER_MTOK=
# Server-side refusal fallback for models that support it (on|off).
AI_REFUSAL_FALLBACK=on
# Per-user generation requests allowed per minute (all instances combined).
RATE_LIMIT_GENERATIONS_PER_MINUTE=6

# --- iPhone app (mobile/) -----------------------------------------------------
# Only for the app's browser preview during development (e.g. http://localhost:8081).
# The native iOS app doesn't need CORS; leave empty in production.
API_CORS_ORIGINS=

# --- Stripe (subscriptions) ---------------------------------------------------
# Use test-mode keys (sk_test_…) during development. Billing stays disabled
# until the secret key, webhook secret and at least one price ID are set.
STRIPE_SECRET_KEY=
# Not required by hosted Checkout; reserved for future client-side Stripe use.
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
# From `stripe listen` (local) or the Dashboard webhook endpoint (deployed).
STRIPE_WEBHOOK_SECRET=
# Monthly recurring EUR Price IDs. Amounts must match lib/billing/plans.ts.
STRIPE_PRICE_STARTER=
STRIPE_PRICE_GROWTH=
STRIPE_PRICE_PRO=

{
  "expo": {
    "name": "PinNudge",
    "slug": "pinnudge",
    "scheme": "pinnudge",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#fbfaf7",
    "ios": {
      "bundleIdentifier": "com.example.pinnudge",
      "buildNumber": "1",
      "supportsTablet": false,
      "config": { "usesNonExemptEncryption": false },
      "privacyManifests": {
        "NSPrivacyAccessedAPITypes": [
          { "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults", "NSPrivacyAccessedAPITypeReasons": ["CA92.1"] }
        ]
      }
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      ["expo-secure-store", { "faceIDPermission": false }],
      [
        "expo-image-picker",
        {
          "photosPermission": "PinNudge lets you choose product photos to use on your pins.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": false,
          "savePhotosPermission": "PinNudge saves the pins you design to your photo library so you can post them."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 160,
          "backgroundColor": "#fbfaf7"
        }
      ],
      "expo-sharing",
      "expo-image",
      "expo-font",
      "expo-web-browser",
      "expo-status-bar"
    ]
  }
}
